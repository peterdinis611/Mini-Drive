{
  "name": "mini-drive",
  "private": true,
  "type": "module",
  "version": "0.0.2",
  "packageManager": "pnpm@11.1.2",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "NODE_OPTIONS='--max-old-space-size=4096' vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build && tsc --noEmit",
    "start": "node scripts/start-prod.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio",
    "db:backup": "tsx scripts/backup-db.ts",
    "db:restore": "tsx scripts/restore-db.ts",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:k6": "k6 run k6/load.ts",
    "test:k6:smoke": "k6 run k6/smoke.ts",
    "test:k6:spike": "k6 run k6/spike.ts",
    "test:k6:share-rate": "k6 run k6/share-rate.ts",
    "test:k6:typecheck": "tsc --noEmit -p k6/tsconfig.json",
    "screenshots": "node scripts/capture-screenshots.mjs"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.14",
    "@clerk/tanstack-react-start": "^1.7.8",
    "@embedpdf/react-pdf-viewer": "^2.15.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/hotkeys": "0.18.0",
    "@tanstack/react-devtools": "0.10.13",
    "@tanstack/react-hotkeys": "^0.17.0",
    "@tanstack/react-pacer": "^0.24.1",
    "@tanstack/react-query": "5.104.4",
    "@tanstack/react-query-devtools": "5.104.4",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.3",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.24",
    "@tanstack/redact": "^0.2.3",
    "@tiptap/extension-link": "^3.32.1",
    "@tiptap/extension-placeholder": "^3.32.1",
    "@tiptap/pm": "^3.32.1",
    "@tiptap/react": "^3.32.1",
    "@tiptap/starter-kit": "^3.32.1",
    "@uploadthing/react": "^7.3.3",
    "better-auth": "^1.7.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.1",
    "date-fns": "^4.4.0",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "exifr": "^7.1.3",
    "file-bytes": "^2.0.3",
    "fuse.js": "^7.5.0",
    "jszip": "^3.10.2",
    "lucide-react": "^0.577.0",
    "motion": "^14.8.0",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.2",
    "pg": "^8.23.1",
    "pompelmi": "^1.20.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^19.3.1",
    "react-easy-crop": "^6.2.4",
    "react-error-boundary": "^6.1.6",
    "redis": "^6.3.1",
    "srvx": "^1.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.9.1",
    "uploadthing": "^7.7.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@clerk/testing": "^2.2.52",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/router-cli": "^1.167.46",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jszip": "^3.4.1",
    "@types/k6": "^2.3.1",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.38",
    "@vitest/coverage-v8": "^5.0.5",
    "dotenv": "^17.4.2",
    "jsdom": "^30.1.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
