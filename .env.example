# SQLite database file (relative to project root)
DATABASE_URL="dev.db"

# Public site origin (canonical URLs, sitemap, robots, CSRF). No trailing slash.
APP_URL="http://localhost:3000"

# Better Auth — generate with: pnpm dlx @better-auth/cli secret
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="replace-with-openssl-rand-base64-32"

# UploadThing — from https://uploadthing.com/dashboard
UPLOADTHING_TOKEN=""

# production tip:
# APP_URL="https://your-domain.com"
# BETTER_AUTH_URL="https://your-domain.com"
# NODE_ENV=production
