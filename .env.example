# SQLite database file (relative to project root, or absolute path)
# Local: dev.db · Production: /data/mini-drive.db (persistent volume)
DATABASE_URL="dev.db"

# Public site origin (canonical URLs, sitemap, robots, CSRF). No trailing slash.
# Production MUST be https://your-domain (not localhost).
APP_URL="http://localhost:3000"

# Clerk — from https://dashboard.clerk.com (Application → API Keys)
# Production: use pk_live_ / sk_live_ and allow the production APP_URL origins.
VITE_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
VITE_CLERK_SIGN_IN_URL="/sign-in"
VITE_CLERK_SIGN_UP_URL="/sign-up"
VITE_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/"
VITE_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/"

# UploadThing — from https://uploadthing.com/dashboard
# Dashboard: set ACL to private; register production APP_URL.
UPLOADTHING_TOKEN=""

# Audit IP hashing (recommended in production; falls back to CLERK_SECRET_KEY)
# AUDIT_IP_PEPPER="$(openssl rand -hex 32)"

# Encrypted DB backups: pnpm db:backup / pnpm db:restore
# BACKUP_ENCRYPTION_KEY="at-least-16-chars-secret"

# Virus scan before public share (heuristics always on unless VIRUS_SCAN=off)
# Uses pompelmi → ClamAV (exit-code / clamd INSTREAM; no stdout parsing)
# VIRUS_SCAN=off
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310
# CLAMAV_SOCKET=/run/clamav/clamd.sock
# CLAMAV_LOCAL=1
# CLAMAV_TIMEOUT_MS=30000
# VIRUS_SCAN_REQUIRE_CLAMAV=1

# --- production ---
# NODE_ENV=production
# APP_URL="https://your-domain.com"
# DATABASE_URL="/data/mini-drive.db"
# VITE_CLERK_PUBLISHABLE_KEY="pk_live_..."
# CLERK_PUBLISHABLE_KEY="pk_live_..."
# CLERK_SECRET_KEY="sk_live_..."
# UPLOADTHING_TOKEN="..."
# AUDIT_IP_PEPPER="..."
# BACKUP_ENCRYPTION_KEY="..."
