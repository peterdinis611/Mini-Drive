# SQLite database file (relative to project root)
DATABASE_URL="dev.db"

# Public site origin (canonical URLs, sitemap, robots, CSRF). No trailing slash.
APP_URL="http://localhost:3000"

# Clerk — from https://dashboard.clerk.com (Application → API Keys)
VITE_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
VITE_CLERK_SIGN_IN_URL="/sign-in"
VITE_CLERK_SIGN_UP_URL="/sign-up"
VITE_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/"
VITE_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/"

# UploadThing — from https://uploadthing.com/dashboard
UPLOADTHING_TOKEN=""

# Audit IP hashing (optional; falls back to CLERK_SECRET_KEY)
# AUDIT_IP_PEPPER="openssl-rand-hex-32"

# Encrypted DB backups: pnpm db:backup / pnpm db:restore
# BACKUP_ENCRYPTION_KEY="at-least-16-chars-secret"

# Virus scan before public share (heuristics always on unless VIRUS_SCAN=off)
# VIRUS_SCAN=off
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310
# VIRUS_SCAN_REQUIRE_CLAMAV=1

# production tip:
# APP_URL="https://your-domain.com"
# NODE_ENV=production
