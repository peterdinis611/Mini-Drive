# SQLite database file (relative to project root)
DATABASE_URL="dev.db"

# Public site origin (canonical URLs, sitemap, robots, CSRF). No trailing slash.
APP_URL="http://localhost:3000"

# Better Auth — generate with: pnpm dlx @better-auth/cli secret
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="replace-with-openssl-rand-base64-32"

# UploadThing — from https://uploadthing.com/dashboard
UPLOADTHING_TOKEN=""

# Audit IP hashing (optional; falls back to BETTER_AUTH_SECRET)
# AUDIT_IP_PEPPER="openssl-rand-hex-32"

# Encrypted DB backups: pnpm db:backup / pnpm db:restore
# BACKUP_ENCRYPTION_KEY="at-least-16-chars-secret"

# Virus scan before public share (heuristics always on unless VIRUS_SCAN=off)
# VIRUS_SCAN=off
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310
# VIRUS_SCAN_REQUIRE_CLAMAV=1

# production tip:
# APP_URL="https://your-domain.com"
# BETTER_AUTH_URL="https://your-domain.com"
# NODE_ENV=production
