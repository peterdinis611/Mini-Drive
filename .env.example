# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/mini_drive"

# Public site origin (canonical URLs, sitemap, robots, CSRF, Clerk authorizedParties).
# No trailing slash. Production MUST be https://your-domain (not localhost).
APP_URL="http://localhost:3000"

# Clerk — from https://dashboard.clerk.com (Application → API Keys)
# Production: use pk_live_ / sk_live_ and allow the production APP_URL origins.
# Dashboard hardening (required for go-live):
#   - MFA (at least TOTP) for users
#   - Strong password policy
#   - Bot protection / Captcha on sign-in
#   - Short session lifetime + revoke sessions after password change
VITE_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
VITE_CLERK_SIGN_IN_URL="/sign-in"
VITE_CLERK_SIGN_UP_URL="/sign-up"
VITE_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/"
VITE_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/"

# UploadThing — from https://uploadthing.com/dashboard
# Dashboard: ACL = private; signed URL TTL stays short (~5 min in app).
# Register production APP_URL.
UPLOADTHING_TOKEN=""

# Required in production — HMAC pepper for share-access IP hashing (never reuse Clerk secrets).
# AUDIT_IP_PEPPER="$(openssl rand -hex 32)"

# Redis / Upstash — shared sliding-window rate limits across instances.
# Without REDIS_URL the app falls back to in-memory Map (single process only).
# REDIS_URL="redis://127.0.0.1:6379"
# REDIS_URL="rediss://default:TOKEN@REGION.upstash.io:6379"

# Encrypted DB backups: pnpm db:backup / pnpm db:restore (requires pg_dump / pg_restore)
# BACKUP_ENCRYPTION_KEY="at-least-16-chars-secret"

# Virus scan before public share (heuristics always on unless VIRUS_SCAN=off)
# VIRUS_SCAN=off
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310

# --- production / docker compose ---
# NODE_ENV=production
# APP_URL="https://your-domain.com"
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=mini_drive
# DATABASE_URL="postgresql://postgres:postgres@db:5432/mini_drive"
# AUDIT_IP_PEPPER="$(openssl rand -hex 32)"
# REDIS_URL="redis://redis:6379"
